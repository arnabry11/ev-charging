# Compose / local development. Copy to .env. Never commit real secrets.

POSTGRES_USER=ev
POSTGRES_PASSWORD=ev
GATEWAY_DB=ev_gateway
PLATFORM_DB=ev_platform

GATEWAY_DB_PORT=5433
PLATFORM_DB_PORT=5434
REDIS_PORT=6379

GATEWAY_HTTP_PORT=8080
GATEWAY_OCPP_PORT=9000
PLATFORM_HTTP_PORT=3000

# Demo charger Basic auth (Security Profile 1). Format: charger_id:password[,id:password]
# The simulator runs SIM_CHARGER_COUNT chargers, counting up from CHARGER_ID.
CHARGER_AUTH=CHG-MUM-0001:demo-password,CHG-MUM-0002:demo-password,CHG-MUM-0003:demo-password,CHG-MUM-0004:demo-password,CHG-MUM-0005:demo-password,CHG-MUM-0006:demo-password,CHG-MUM-0007:demo-password,CHG-MUM-0008:demo-password,CHG-MUM-0009:demo-password,CHG-MUM-0010:demo-password
CHARGER_ID=CHG-MUM-0001
SIM_CHARGER_COUNT=10
CHARGER_PASSWORD=demo-password
SIMULATOR_HTTP_PORT=8081
SIM_POWER_W=7200
SIM_METER_START_WH=100000
SIM_TICK_INTERVAL_MS=1000
# Each one-second tick advances a charger by this many simulated seconds. 10 makes a 7.2 kW charger deliver 20 Wh per real second.
SIM_SECONDS_PER_TICK=10

# HMAC secrets for the gateway <-> platform contract (rotate later).
GATEWAY_SIGNING_SECRET=dev-gateway-secret
PLATFORM_SIGNING_SECRET=dev-platform-secret

# Rails needs this in Compose. Local-only; not a production secret.
SECRET_KEY_BASE=dev-insecure-secret-key-base-for-compose-only

# Integer percent snapshotted onto each invoice. Intra-state CGST/SGST only.
GST_RATE_PERCENT=18
SESSION_MAX_DURATION_S=5400

# Each open live-board stream holds one Puma thread, so keep the stream cap well below the thread count.
RAILS_MAX_THREADS=16
LIVE_STREAM_MAX_CONNECTIONS=8

# How many times the platform may refuse one gateway event before the gateway gives up on it
# (and on the events queued behind it in the same session). Outages and bad signatures never count.
OUTBOX_MAX_REJECTIONS=10
