<% content_for(:title, "Sessions") %>
<h1>Sessions</h1>
<% if @sessions.empty? %>
  <p>No sessions yet.</p>
<% else %>
  <table>
    <thead>
      <tr>
        <th>State</th>
        <th>Charger</th>
        <th>Phone</th>
        <th class="money">Prepaid</th>
        <th class="money">Invoice</th>
        <th class="money">Refund</th>
      </tr>
    </thead>
    <tbody>
      <% @sessions.each do |session| %>
        <tr>
          <td><%= link_to session.state, admin_session_path(session) %></td>
          <td><%= session.charger.ocpp_id %></td>
          <td><%= session.driver.phone %></td>
          <td class="money"><%= paise_to_rupees(session.prepaid_paise) %></td>
          <td class="money"><%= paise_to_rupees(session.invoice&.total_paise) %></td>
          <td class="money"><%= paise_to_rupees(session.refund&.amount_paise) %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>
