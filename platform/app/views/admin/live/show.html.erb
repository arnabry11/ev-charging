<% content_for(:title, "Live") %>
<h1>Live</h1>
<p class="note">Updates as it happens over a server-sent event stream. The amount prices the latest meter reading with the session tariff. The invoice is issued when the session stops.</p>

<div id="live-board" data-stream-url="<%= admin_live_stream_path %>">
  <%= render "admin/live/board", board: @board %>
</div>

<script>
  (function () {
    var board = document.getElementById("live-board");
    if (!board || !window.EventSource) return;
    var source = new EventSource(board.dataset.streamUrl);
    source.addEventListener("board", function (event) { board.innerHTML = event.data; });
    window.addEventListener("pagehide", function () { source.close(); });
  })();
</script>
